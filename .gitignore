# 2.1a Исключаем артефакты сборки
/build
/dist

# 2.1b Исключаем все jar-файлы, кроме module2.jar
*.jar
!module2.jar

# 2.1c Исключаем локальные файлы настроек
application-local.properties
.env.local
*.local

# 2.1d Исключаем папку .idea полностью
.idea/

# 2.1e Исключаем .idea_copy, кроме workspace.xml
.idea_copy/*
!.idea_copy/workspace.xml

# 2.2 Исключаем все папки build, но не файлы с именем build
**/build/
!**/build
# Пояснение: файл module2.jar из п 2.1.b по-прежнему не должен игнорироваться

# Стандартные исключения для React/Node.js
node_modules/
*.log
.DS_Store
coverage/
.env
.env.test
.env.production